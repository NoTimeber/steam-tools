# ===== Steam 工具台 运行配置 =====
# 复制本文件为 .env 并按需修改。.env 不要提交到版本库。

# 监听端口
PORT=53110

# 监听网卡。默认 0.0.0.0(对外可达)。
# 若用 Nginx/Caddy 反向代理,建议改成 127.0.0.1 只让代理访问。
HOST=0.0.0.0

# 访问口令(可选)。推荐留空,首次打开网页 /login 会让你直接设置初始口令,
# 之后在「运行设置 → 修改口令」里改,全程不用动这个文件。
# 这里若填了值,则作为初始口令(网页里修改后以网页设置为准,存 data/config/auth.json)。
# 注意:口令未设置前,除登录页外全部锁定,不会裸奔。
# APP_PASSWORD=

# 会话有效期(毫秒),默认 7 天。
SESSION_TTL_MS=604800000

# 登录 cookie 是否加 Secure 标记。仅当通过 HTTPS 访问时设为 1,
# 否则普通 HTTP 会拿不到 cookie 导致一直跳登录页。
COOKIE_SECURE=0

# UU 发货轮询间隔(毫秒),默认 20000,最低 5000。
UU_POLL_INTERVAL_MS=20000

# CS2 自动上架：外部检视(磨损)解析服务地址与密钥(见 inspect-service/)。
# 留空则 UU 未返回磨损的物品直接跳过不上架；配置后会用它解析磨损兜底。
# INSPECT_SERVICE_URL=http://127.0.0.1:53120
# INSPECT_KEY=与 inspect-service 相同的密钥

# ===== 远程自动更新(GitHub Releases) =====
# 放发布包的 GitHub 公开仓库,形如 owner/repo。填了它,客户端就会从
# https://github.com/<owner/repo>/releases/latest/download/manifest.json 检查更新。
GITHUB_REPO=NoTimeber/steam-tools

# 关闭自动更新填 0(默认开)。
# AUTO_UPDATE=1

# 自动检查更新的间隔(毫秒)。默认每天一次(86400000);冷启动时会额外检查一次。
# 也可在「运行设置 → 检查更新」里手动触发。
# UPDATE_CHECK_INTERVAL_MS=86400000

# 国内下载加速:可选镜像前缀,会拼在 GitHub 链接前(如 https://ghproxy.com/)。
# 仅加速下载,sha256/签名仍会校验,经镜像也安全。留空=直连 GitHub。
# UPDATE_DOWNLOAD_PREFIX=https://ghproxy.com/

# 直接覆盖清单地址(一般不用;填了优先于 GITHUB_REPO)。
# UPDATE_MANIFEST_URL=

# ----- 以下一般无需改动,留空即用项目内自带资源 -----
# 物品 schema + 本地化文案默认在 app/schema/ 下(随发布包一起下发);config 默认在 data/ 下。
# SCHEMA_DIR=  # 覆盖 schema/本地化目录(items_game/tf2_items_game/csgo_schinese/csgo_english 等)
# CONFIG_DIR=
# CS2_ITEMS_GAME_FILE=
# TF2_ITEMS_GAME_FILE=
