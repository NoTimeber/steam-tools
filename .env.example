# ===== Steam 工具台 运行配置 =====
# 复制本文件为 .env 并按需修改。.env 不要提交到版本库。
# Docker 部署时 docker-compose 会读取同目录的 .env;DATA_DIR/HOST/PORT/TRUST_PROXY 已在 compose 里设好。

# 监听端口
PORT=53110

# 监听网卡。Docker 里保持 0.0.0.0(端口只映射到宿主 127.0.0.1,由反代对外)。
# 本地直接运行且不想让局域网访问时改成 127.0.0.1。
HOST=0.0.0.0

# ----- 访问口令 -----
# 推荐留空:首次打开 /login 设置初始口令,之后在「运行设置 → 修改口令」里改(存 data/config/auth.json)。
# 首次设置需要填「初始化令牌」,令牌打印在服务端启动日志里(docker compose logs steam-tools)。
# 这里若填了值,则作为初始口令(网页里修改后以网页设置为准)。
# APP_PASSWORD=

# 固定初始化令牌(可选,不填则每次启动随机生成)。
# SETUP_TOKEN=

# 会话有效期(毫秒),默认 7 天。
SESSION_TTL_MS=604800000

# 登录 cookie 的 Secure 标记:auto(默认)=经 HTTPS 访问(含反代转发)时自动加;1=总是加;0=从不加。
COOKIE_SECURE=auto

# 反代信任:要拿到真实客户端 IP(登录限速)和 HTTPS 判断,必须信任反代转发的 X-Forwarded-*。
# 默认 loopback(只信任本机反代)。Docker compose 里已设为 loopback,uniquelocal。
# TRUST_PROXY=loopback

# 额外允许的来源(逗号分隔的完整 origin)。默认只允许与访问地址同域,一般不用填。
# ALLOWED_ORIGINS=https://tools.example.com

# 运行数据目录(加密数据库 steam-tools.db 等)。默认是安装根下的 data/,Docker 里是 /data。
# DATA_DIR=

# ----- 数据库主密钥 -----
# 账号密码、shared_secret、maFile、Steam session、UU token 在数据库里都是 AES-256-GCM 密文,靠这把密钥解开。
# 读取顺序:MASTER_KEY(base64 或 hex,32 字节) > MASTER_KEY_FILE 指向的文件 > <安装根>/secrets/master.key。
# Docker 部署用 compose 的 secrets 挂载 ./secrets/master.key,不要在这里填 MASTER_KEY。
# 本地开发时缺密钥文件会自动生成;生产环境(NODE_ENV=production)缺失则拒绝启动。
# MASTER_KEY_FILE=

# 调试端点(/api/cookies/:id 会返回 Steam cookies,/api/steam-purchase/test 可触发真实下单)。默认关闭。
# ENABLE_DEBUG_ENDPOINTS=1

# ----- Steam 会话 -----
# 服务重启后自动恢复上次在线的账号(优先 refreshToken,失效再用密码 + maFile 令牌)。关闭填 0。
# SESSION_RESTORE=1
# 自动恢复时账号之间的间隔(毫秒),默认 3000,避免同时登录触发 Steam 限频。
# SESSION_RESTORE_INTERVAL_MS=3000
# 登录超时(毫秒)与超时后的重试次数。
# LOGIN_TIMEOUT_MS=45000
# LOGIN_RETRY_MAX=2
# 掉线重连看门狗:扫描间隔 / 掉线后先等 steam-user 自己重连的宽限期 / 最多重连次数。
# RECONNECT_WATCHDOG_INTERVAL_MS=30000
# RECONNECT_GRACE_MS=90000
# RECONNECT_MAX_ATTEMPTS=6

# ----- 业务 -----
# UU 发货轮询间隔(毫秒),默认 300000(5 分钟),范围 30 秒 ~ 120 分钟。
UU_POLL_INTERVAL_MS=300000

# CS2 自动上架：外部检视(磨损)解析服务地址与密钥(见 inspect-service/)。
# 留空则 UU 未返回磨损的物品直接跳过不上架；配置后会用它解析磨损兜底。
# INSPECT_SERVICE_URL=http://127.0.0.1:53120
# INSPECT_KEY=与 inspect-service 相同的密钥

# ----- 镜像版本 -----
# docker-compose.yml 默认拉 ghcr.io/notimeber/steam-tools:latest。要固定在某个版本,填版本号(不带 v),如 1.6.1。
# STEAM_TOOLS_TAG=latest

# ----- 新版本提示 -----
# 面板会查这个 GitHub 仓库的最新 Release,有新版时在顶部提示(只提示,更新仍是 git pull && docker compose pull && docker compose up -d)。
# 默认 NoTimeber/steam-tools;自己 fork 部署的改成自己的仓库。
# GITHUB_REPO=NoTimeber/steam-tools
# 不想让服务器访问 GitHub 填 0。
# UPDATE_CHECK=1

# ----- 以下一般无需改动,留空即用项目内自带资源 -----
# 物品 schema + 本地化文案默认在 app/schema/ 下;config 默认在 data/config 下。
# SCHEMA_DIR=
# CONFIG_DIR=
# CS2_ITEMS_GAME_FILE=
# TF2_ITEMS_GAME_FILE=
