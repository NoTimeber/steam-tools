# ===== 运行数据与凭据(绝不入库) =====
# 账号密码、maFile、session/refreshToken、UU token、指纹缓存等全部在 data/ 下。
/data/
/logs/
.env
inspect_key.txt

# 数据库主密钥(和 data/ 分开保管、分开备份)
/secrets/

# 证书/私钥
*.pem

# app/data 只保留随代码分发的 cs2-skin-db.json,其余(一次性脚本写的 session/token)不入库
/app/data/*
!/app/data/cs2-skin-db.json

# ===== 依赖与工具 =====
node_modules/
npm-debug.log*
.DS_Store
Thumbs.db

# 前端构建产物(web/ 下 npm run build 生成)
/web/dist/

# 本机预览配置(写的是本机 Node 路径)
/.claude/launch.json
