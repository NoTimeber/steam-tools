{
  "name": "steam-tools",
  "version": "1.6.11",
  "private": true,
  "description": "Steam 多账号工具台(服务端)",
  "main": "src/main.ts",
  "engines": {
    "node": ">=24.5"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.e2e.ts\"",
    "demo": "node test/demo/server.ts",
    "build:names": "node scripts/build-cs2-names.ts"
  },
  "dependencies": {
    "binarykvparser": "^2.3.0",
    "express": "5.2.1",
    "globaloffensive": "^3.3.0",
    "kvparser": "^1.0.2",
    "lzma-native": "^8.0.6",
    "protobufjs": "7.5.6",
    "socket.io": "4.8.3",
    "steam-totp": "2.1.2",
    "steam-tradeoffer-manager": "^2.13.0",
    "steam-user": "5.3.0",
    "steamcommunity": "^3.50.0",
    "steamstore": "^2.4.0",
    "tf2": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
