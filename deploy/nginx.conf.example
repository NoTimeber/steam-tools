# 已有 Nginx 时的反代示例(放到 /etc/nginx/conf.d/ 下改域名和证书路径)。
# 容器只监听宿主 127.0.0.1:53110,公网流量必须经这里的 HTTPS。

map $http_upgrade $connection_upgrade {
	default upgrade;
	''      close;
}

server {
	listen 80;
	server_name tools.example.com;
	return 301 https://$host$request_uri;
}

server {
	listen 443 ssl;
	http2 on;
	server_name tools.example.com;

	ssl_certificate     /etc/letsencrypt/live/tools.example.com/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/tools.example.com/privkey.pem;

	# maFile 批量导入的请求体可能超过默认的 1m
	client_max_body_size 2m;

	location / {
		proxy_pass http://127.0.0.1:53110;
		proxy_http_version 1.1;

		# socket.io 需要 WebSocket 升级
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $connection_upgrade;

		# 用 $http_host(带端口)而不是 $host:服务端的同源校验要拿它和浏览器的 Origin 比对
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;

		# 长连接(实时日志/状态推送)
		proxy_read_timeout 1h;
		proxy_send_timeout 1h;
	}
}
